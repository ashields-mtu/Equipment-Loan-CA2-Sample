@startuml
title Design Structure / Package View

skinparam packageStyle rectangle

package "User Interface" as ui {
  class LoanRequestUI
  class CoordinatorUI
}

package "Application" as application {
  class LoanRequestController
  class SubmitLoanRequestResult
  class ReviewSummaryResult
  class LoanDecisionResult
}

package "Domain" as domain {
  class Member
  class LoanCoordinator
  class LoanRequest
  class LoanPeriod
  class EquipmentType
  class LoanDecision
  class EquipmentReservation
  class AvailabilityPolicy
}

package "Ports" as ports {
  interface MemberRepository
  interface EquipmentTypeRepository
  interface LoanRequestRepository
  interface ReservationRepository
  interface RequestReferenceGenerator
}

ui ..> application : invokes use cases
application ..> domain : coordinates
application ..> ports : uses abstractions
domain ..> ports : availability query port

@enduml
